# Normalise line endings in the repository so Windows and CI agree.
#
# Without this, core.autocrlf=true rewrites LF to CRLF on every checkout and git
# warns on every file that gets staged. Storing LF and checking out CRLF keeps
# diffs clean on Windows while the repository stays byte-identical everywhere.
* text=auto eol=lf

# Shell scripts must stay LF or they break on Linux.
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows-only tooling expects CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary: never touched.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Excel workbooks, including the ~$ lock files Excel leaves behind while a file
# is open. The lock files are transient and must never be committed.
*.xlsx binary
*.xls binary
~$*.xlsx binary
~$*.xls binary
~$*.docx binary
~$*.pptx binary